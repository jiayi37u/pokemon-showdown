+		tracker.parseMessage('|-boost|p2a: Lucario|atk|2');
+		// Second Swords Dance / 第二次剑舞
+		tracker.parseMessage('|-boost|p2a: Lucario|atk|2');
+
+		const boosts = tracker.getOurActiveBoosts('a');
