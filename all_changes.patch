+		if (ctx.attacker.moves.some(m => toID(m) === 'auroraveil')) {
+			bonus += 5;
+			ctx.adjustments.push({
+				reason: 'Hail/Snow enables Aurora Veil',
+				amount: 5,
+				category: 'positive',
+			});
