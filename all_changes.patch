+		// Immune to sandstorm damage
+		const sandImmune = ctx.attacker.types.some(t => ['Rock', 'Ground', 'Steel'].includes(t)) ||
+			['magicguard', 'overcoat', 'sandveil', 'sandrush', 'sandforce'].includes(abilityId);
+		if (sandImmune && !bonus) {
