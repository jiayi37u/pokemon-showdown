+				const hasSpecialMoves = ctx.target.moves?.some(m => {
+					const dexMove = Dex.moves.get(m);
+					return dexMove.category === 'Special' && dexMove.basePower > 0;
+				}) ?? false;
+
+				if (hasSpecialMoves) {
+					bonus += 8;
+					ctx.adjustments.push({
