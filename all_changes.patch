+	// Misty Terrain blocks status
+	if (terrain === 'misty') {
+		const statusMoves = ['thunderwave', 'toxic', 'willowisp', 'spore', 'sleeppowder',
+			'confuseray', 'swagger', 'flatter'];
+		if (statusMoves.includes(moveId)) {
