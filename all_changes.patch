+				amount: -5,
+				category: 'negative',
+			});
+		}
+	}
+
+	// Perish Body - Both get Perish Song effect
+	if (targetAbility === 'perishbody') {
+		penalty -= 5;
+		ctx.adjustments.push({
+			reason: 'Perish Body will inflict Perish Song on contact',
+			amount: -5,
+			category: 'negative',
