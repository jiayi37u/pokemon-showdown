+
+	/** Our side conditions (for tracking hazards on our side) */
+	private ourSideConditions: {
+		stealthrock: boolean,
+		spikes: number,
+		toxicspikes: number,
+		stickyweb: boolean,
+		reflect: number,
+		lightscreen: number,
+		auroraveil: number,
+		tailwind: number,
+	} = {
