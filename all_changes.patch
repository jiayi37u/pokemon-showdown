+/** Create a fresh AI cache */
+export function createAICache(turn: number): AICache {
+	return {
+		damageCalc: new Map(),
+		typeEffectiveness: new Map(),
+		speedComparison: new Map(),
+		knockoutCalc: new Map(),
+		turn,
+	};
