+	// Rocky Helmet - 1/6 HP damage
+	if (targetItem === 'rockyhelmet') {
+		if (!hasMagicGuard) {
+			const damagePenalty = ctx.attacker.hpPercent <= 20 ? -5 : -2;
+			penalty += damagePenalty;
+			ctx.adjustments.push({
