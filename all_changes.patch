+	// Pickpocket - Steals item on contact
+	if (targetAbility === 'pickpocket') {
+		if (ctx.attacker.item && attackerAbility !== 'stickyhold') {
+			penalty -= 2;
+			ctx.adjustments.push({
+				reason: 'Pickpocket may steal item on contact',
+				amount: -2,
+				category: 'negative',
+			});
+		}
+	}
