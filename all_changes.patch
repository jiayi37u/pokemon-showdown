+		const tracker = createBattleTracker('p2');
+
+		// First layer / 第一层
+		tracker.parseMessage('|-sidestart|p1: Opponent|Spikes');
+		let conditions = tracker.getOpponentSideConditions();
+		assert.strictEqual(conditions.spikes, 1, 'Spikes layer 1 / 撒菱第1层');
+
+		// Second layer / 第二层
+		tracker.parseMessage('|-sidestart|p1: Opponent|Spikes');
